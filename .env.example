# Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-random-key-here-min-50-characters
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1,yourcustomdomain.com
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# Database (PostgreSQL URL provided by Render / Railway / Supabase / Neon)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Email Settings (Optional for live SMTP delivery; defaults to console backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=GLINT Support <support@glintgifts.com>
